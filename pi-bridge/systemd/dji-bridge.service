[Unit]
Description=DJI RS gimbal bridge for fps-camcontrol
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=worship
WorkingDirectory=/home/worship/dji-bridge
Environment=PYTHONUNBUFFERED=1
# Target deployment convention: /home/worship/dji-bridge -> repo pi-bridge/.
# Create /etc/default/dji-bridge with DJI_RS3_BLE_ADDRESS=34:D2:62:15:A5:47.
EnvironmentFile=-/etc/default/dji-bridge
ExecStart=/home/worship/dji-bridge/.venv/bin/python3 /home/worship/dji-bridge/dji_bridge.py --host 0.0.0.0 --port 7878 --driver dji-rs3-ble
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
