# Settings for the single-instance bridge.
#   system unit: /etc/default/dji-bridge        user service: ~/.config/dji-bridge/env
# The gimbal actually driven is the one saved in gimbal.json in the state directory (chosen in Device Config ->
# the rig -> Choose gimbal..., or by scripts/install-pi-bridge.sh --gimbal). This address is only the fallback
# when nothing is saved. Leave it empty to pick the strongest advertising DJI gimbal on first start; that choice
# is saved, so the bridge never silently swaps gimbals later when signal strengths change.
DJI_RS3_BLE_ADDRESS=
# Joystick gain at full stick (safe range 1..1000). The deployed gimbals use 200.
DJI_RS3_MAX_JOYSTICK=200
