+
+// A camera object for a network camera at a known address, without discovery. cameraId is its MAC address
+// ("10:32:2C:7D:84:31"), ip a dotted IPv4 address, model the model name the camera reports ("ILME-FX3A").
+std::shared_ptr<CameraDevice> CameraWebController::makeDirectCamera(const std::string& cameraId, const std::string& ip, const std::string& model, ApiResponse& response) {
+    static const std::map<std::string, SDK::CrCameraDeviceModelList> models = {
+        {"ILCE-7SM3", SDK::CrCameraDeviceModel_ILCE_7SM3},
+        {"ILME-FX3", SDK::CrCameraDeviceModel_ILME_FX3},
+        {"ILME-FX3A", SDK::CrCameraDeviceModel_ILME_FX3A},
+    };
+    auto m = models.find(model);
+    if (m == models.end()) {
+        response.success = false;
+        response.message = "Direct connect: unsupported model '" + model + "'";
+        return nullptr;
+    }
+    struct in_addr addr {};
+    if (inet_pton(AF_INET, ip.c_str(), &addr) != 1) {
+        response.success = false;
+        response.message = "Direct connect: invalid IP address '" + ip + "'";
+        return nullptr;
+    }
+    CrInt8u mac[6] = {0};
+    unsigned int b[6];
+    if (std::sscanf(cameraId.c_str(), "%2x:%2x:%2x:%2x:%2x:%2x", &b[0], &b[1], &b[2], &b[3], &b[4], &b[5]) != 6) {
+        response.success = false;
+        response.message = "Direct connect: camera id must be its MAC address";
+        return nullptr;
+    }
+    for (int i = 0; i < 6; ++i) mac[i] = static_cast<CrInt8u>(b[i]);
+    SDK::ICrCameraObjectInfo* info = nullptr;
+    auto err = SDK::CreateCameraObjectInfoEthernetConnection(&info, m->second, static_cast<CrInt32u>(addr.s_addr), mac, 0);
+    if (CR_FAILED(err) || !info) {
+        response.success = false;
+        response.message = "Direct connect: the SDK could not create a camera object for " + ip;
+        return nullptr;
+    }
+    auto camera = std::make_shared<CameraDevice>(static_cast<CrInt32u>(m_availableCameras.size()) + 1, info);
+    info->Release();
+    return camera;
 }
 
