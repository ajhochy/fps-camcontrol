{
  "name": "fps-camcontrol",
  "version": "0.1.0",
  "description": "Game controller → live production camera control surface",
  "license": "MIT",
  "author": "AJ Hochhalter",
  "packageManager": "pnpm@11.1.2",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "checks": "node scripts/checks.cjs pr",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "electron:dev": "pnpm build && electron electron/main.cjs",
    "test:smoke": "ts-node src/testing/smokeTest.ts",
    "sandbox": "pnpm build && node dist/testing/sandbox/sandbox.js",
    "sandbox:check": "pnpm build && node dist/testing/sandbox/sandbox.js --selftest",
    "test:smoke:isolated": "pnpm build && node dist/testing/sandbox/sandbox.js --smoke",
    "electron:probe:package": "node scripts/package-electron-probe.cjs",
    "test:electron:foundation": "node scripts/test-electron-foundation.cjs",
    "test:electron:probe": "node scripts/run-electron-probe.cjs",
    "electron:package": "node scripts/package-electron-manual.cjs",
    "test:electron:manual": "node scripts/test-electron-manual-package.cjs",
    "test:electron:runtime": "node scripts/test-electron-manual-runtime.cjs",
    "test:tracking": "pnpm build && node scripts/check-tracking.cjs",
    "tracking:calibrate": "ts-node scripts/tracking-calibrate.ts",
    "electron:package:tracking": "node scripts/package-electron-tracking.cjs",
    "test:electron:tracking": "node scripts/test-electron-tracking-package.cjs",
    "test:electron:tracking:runtime": "node scripts/test-electron-tracking-runtime.cjs"
  },
  "dependencies": {
    "@types/ws": "^8.18.1",
    "atem-connection": "^3.5.0",
    "express": "^4.18.2",
    "js-yaml": "^4.1.0",
    "node-hid": "^3.1.1",
    "pino": "^8.17.2",
    "pino-pretty": "^10.3.1",
    "ws": "^8.20.1",
    "yaml": "^2.9.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@electron/rebuild": "4.2.0",
    "@types/express": "^4.17.21",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.11.5",
    "@types/node-hid": "^1.3.4",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "playwright": "1.58.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "electron-winstaller"
    ],
    "onlyBuiltDependencies": [
      "@julusian/freetype2",
      "electron",
      "node-hid"
    ]
  }
}
